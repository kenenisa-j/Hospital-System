{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "./dist"
  },
  "include": [
    "src/**/*.ts",
    "services/**/*.ts",
    "../database/src/**/*.ts"
  ],
  "exclude": [
    "../database/src/verify_production.ts",
    "../database/src/seed.ts",
    "../database/src/migrate.ts"
  ]
}
